rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to read and write their own progress data
    match /user_progress/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to write research metrics
    match /research_metrics/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow users to submit feedback
    match /user_feedback/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Episode progress tracking - allow authenticated users
    match /episode_progress/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Episode completions - allow authenticated users
    match /episode_completions/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Research sessions - allow authenticated users
    match /research_sessions/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Completed journeys - allow authenticated users
    match /completed_journeys/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Feedback collections - allow authenticated users
    match /feedback/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /validated_feedback/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // User activity logs - allow authenticated users
    match /user_activity_log/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Topic suggestions - allow authenticated users
    match /topic_suggestions/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Admin access - allow admins to read all data
    match /admin_users/{document=**} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    match /admin_config/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    // Research data - allow authenticated users to read and write
    match /research_data/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Community requests - allow authenticated users to read and create
    match /community_requests/{document=**} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (resource.data.user_id == request.auth.uid || isAdmin(request.auth.uid));
    }
    
    // Helper function to check admin status
    function isAdmin(userId) {
      return exists(/databases/$(database)/documents/admin_users/$(userId)) &&
             get(/databases/$(database)/documents/admin_users/$(userId)).data.is_admin == true &&
             get(/databases/$(database)/documents/admin_users/$(userId)).data.status == 'active';
    }
  }
}
